# Line endings: shell and Python files must stay LF (bash fails on CRLF, and a
# WSL copy of a CRLF checkout would show every file as changed); Windows scripts CRLF.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.sv text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Preserve archived run bytes on every platform.
results/claude/2026-11-17/verify-pilot/*.json -text
results/claude/2026-11-17/verify-pilot/recorded-summary.md -text
results/claude/2026-11-19/verify-hard-pilot/*.json -text
results/claude/2026-11-19/verify-hard-pilot/recorded-summary.md -text

# Retain recorded local-run bytes; binary patches preserve their line endings.
results/ollama/**/*.json -text -diff
results/ollama/**/recorded-summary.md -text
